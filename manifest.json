{
  "name": "Nova Play",
  "short_name": "Nova Play",
  "description": "Premium Cinematic PWA Media Player",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#050508",
  "theme_color": "#7C5CFC",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": ["audio/*", "video/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "audio/*": [".mp3", ".wav", ".ogg", ".m4a"],
        "video/*": [".mp4", ".webm", ".mkv"]
      }
    }
  ]
}
